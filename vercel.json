{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "tsc -b && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/tray",
      "destination": "https://noc-prototype.dnsfilter.cloud/tray/dnsfilter-one-app",
      "permanent": false
    },
    {
      "source": "/tray/:path*",
      "destination": "https://noc-prototype.dnsfilter.cloud/tray/:path*",
      "permanent": false
    }
  ]
}
